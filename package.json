{
    "name": "nfstudio",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "author": "David Vaz <davidpvaz@protonmail.com>",
    "scripts": {
        "db:seed": "rm db/dev.db 2> /dev/null; drizzle-kit migrate;tsx db/seeds/data/common/5_nft_metadata/index.ts; tsx db/seeds/index.ts",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "db:generate": "drizzle-kit generate --name $1",
        "db:generate:empty": "drizzle-kit generate --custom --name $1",
        "db:reset": "rm db/dev.db 2> /dev/null; drizzle-kit migrate",
        "dev": "next dev",
        "build": "next build",
        "build:dev": "cp .env .env.local; next build",
        "analyze": "ANALYZE=true next build",
        "start": "next start",
        "lint": "next lint",
        "lint:fix": "next lint --fix --ext .ts,.tsx .",
        "test": "vitest run --coverage",
        "test:grep": "vitest run -t $1"
    },
    "dependencies": {
